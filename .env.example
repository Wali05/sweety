# Copy this file to .env and adjust the values for your machine.
# These are dummy values for local development only.
# With `docker compose up`, only JWT_SECRET, JWT_EXPIRES_IN and APP_TIMEZONE
# are read from here; docker-compose.yml sets the rest.

# Port the API server listens on
PORT=3000

# PostgreSQL connection string
DATABASE_URL=postgres://sweety:sweety@localhost:5432/sweety

# Secret used to sign auth tokens; replace with a long random string
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token lasts (default 7d)
JWT_EXPIRES_IN=7d

# Origin of the React client, allowed by the server's CORS policy
CLIENT_ORIGIN=http://localhost:5173

# Time zone that decides what "today" is for readings (default Asia/Kolkata)
APP_TIMEZONE=Asia/Kolkata
